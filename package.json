{
  "name": "@gosso/client",
  "version": "0.8.2",
  "description": "Browser SDK for Gosso OAuth/OIDC SPA clients.",
  "type": "module",
  "license": "MIT",
  "author": "gosso contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rushairer/gosso-client.git"
  },
  "bugs": {
    "url": "https://github.com/rushairer/gosso-client/issues"
  },
  "homepage": "https://github.com/rushairer/gosso-client#readme",
  "keywords": [
    "gosso",
    "oidc",
    "oauth2",
    "pkce",
    "webauthn",
    "passkeys",
    "sso",
    "spa"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "MIGRATING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.ts\"",
    "lint": "oxlint src",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run quality && npm audit --omit=dev"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "4.1.9",
    "jsdom": "^29.1.1",
    "oxlint": "1.69.0",
    "prettier": "3.8.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~6.0.2",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
